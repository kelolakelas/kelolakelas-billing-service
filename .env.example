JWT_SECRET=change-me-at-least-32-characters-long
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
DB_CHANNEL_BINDING=disable
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kelolakelas_billing
PORT=8082
RESEND_API_KEY=
RESEND_FROM_EMAIL=billing@kelolakelas.com
DUITKU_API_BASE_URL=https://sandbox.duitku.com/webapi/api/merchant
DUITKU_API_KEY=
DUITKU_MERCHANT_CODE=
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=
ACADEMIC_SERVICE_URL=http://localhost:8081
# Identity gRPC address used to check the tenant `billing:read` permission on
# GET /api/v1/billing/transactions and /transactions/:id (tenant members only).
IDENTITY_GRPC_HOST=localhost:50051
# Upper bound for one permission check; on timeout the read answers 503.
IDENTITY_PERMISSION_TIMEOUT_MS=3000
INTERNAL_SERVICE_CREDENTIAL=
SUBSCRIPTION_WORKER_ENABLED=true
SUBSCRIPTION_WORKER_INTERVAL_MINUTES=1440
SUBSCRIPTION_PAYMENT_REMINDER_INTERVAL_DAYS=3
SUBSCRIPTION_PAYMENT_EXPIRY_PERIOD_DAYS=14
TRANSACTION_EXPIRY_WORKER_ENABLED=true
TRANSACTION_EXPIRY_WORKER_INTERVAL_MINUTES=5
# How long an invoice claim may stay unowned before another request may take it over.
# Raise it if a slow gateway response can legitimately exceed this window, otherwise a
# slow attempt would be invoiced twice.
TRANSACTION_CLAIM_TIMEOUT_MINUTES=10