{
    "swagger": "2.0",
    "info": {
        "description": "Billing and Payment Service for KelolaKelas Platform",
        "title": "KelolaKelas Billing Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/billing/transactions": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Billing"
                ],
                "summary": "List billing transactions",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/domain.HTTPResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/domain.TransactionListResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/api/v1/billing/transactions/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Billing"
                ],
                "summary": "Get billing transaction",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Transaction UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/domain.HTTPResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/domain.TransactionResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/api/v1/billing/webhooks/duitku": {
            "post": {
                "description": "Callback endpoint for Duitku payment status updates",
                "consumes": [
                    "application/json",
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Billing"
                ],
                "summary": "Handle Duitku payment webhook callback",
                "parameters": [
                    {
                        "description": "Duitku callback payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.DuitkuCallbackPayload"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.HTTPResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/internal/billing/transactions": {
            "post": {
                "description": "Internal service-to-service endpoint for generating a billing invoice.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Billing"
                ],
                "summary": "Generate subscription payment from an internal service",
                "parameters": [
                    {
                        "description": "Payment request details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.GenerateSubscriptionPaymentRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/domain.HTTPResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/domain.GenerateSubscriptionPaymentResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.DuitkuCallbackPayload": {
            "type": "object",
            "required": [
                "amount",
                "merchantCode",
                "merchantOrderId",
                "resultCode",
                "signature"
            ],
            "properties": {
                "amount": {
                    "type": "string"
                },
                "merchantCode": {
                    "type": "string"
                },
                "merchantOrderId": {
                    "type": "string"
                },
                "merchantUserId": {
                    "type": "string"
                },
                "paymentCode": {
                    "type": "string"
                },
                "productDetail": {
                    "type": "string"
                },
                "reference": {
                    "type": "string"
                },
                "resultCode": {
                    "type": "string"
                },
                "settlementDate": {
                    "type": "string"
                },
                "signature": {
                    "type": "string"
                }
            }
        },
        "domain.ErrorResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "domain.GenerateSubscriptionPaymentRequest": {
            "type": "object",
            "required": [
                "billing_cycle",
                "class_id",
                "enrollment_id",
                "parent_id",
                "student_id",
                "subtotal_amount",
                "tenant_id"
            ],
            "properties": {
                "billing_cycle": {
                    "type": "string",
                    "enum": [
                        "monthly",
                        "quarterly",
                        "yearly"
                    ]
                },
                "class_id": {
                    "type": "string"
                },
                "discount_amount": {
                    "type": "integer",
                    "minimum": 0
                },
                "enrollment_id": {
                    "type": "string"
                },
                "parent_id": {
                    "type": "string"
                },
                "payment_gateway_fee": {
                    "type": "integer",
                    "minimum": 0
                },
                "platform_fee": {
                    "type": "integer",
                    "minimum": 0
                },
                "sender_email": {
                    "type": "string"
                },
                "sender_name": {
                    "type": "string"
                },
                "sender_phone": {
                    "type": "string"
                },
                "student_id": {
                    "type": "string"
                },
                "subtotal_amount": {
                    "type": "integer"
                },
                "tenant_id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "voucher_id": {
                    "type": "string"
                }
            }
        },
        "domain.GenerateSubscriptionPaymentResponse": {
            "type": "object",
            "properties": {
                "checkout_session_url": {
                    "type": "string"
                },
                "gross_amount": {
                    "type": "integer"
                },
                "payment_intent_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "transaction_id": {
                    "type": "string"
                }
            }
        },
        "domain.HTTPResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "domain.TransactionListResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.TransactionResponse"
                    }
                },
                "pagination": {
                    "type": "object",
                    "properties": {
                        "page": {
                            "type": "integer"
                        },
                        "page_size": {
                            "type": "integer"
                        },
                        "total_items": {
                            "type": "integer"
                        },
                        "total_pages": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "domain.TransactionResponse": {
            "type": "object",
            "properties": {
                "checkout_session_url": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "currency": {
                    "type": "string"
                },
                "discount_amount": {
                    "type": "integer"
                },
                "enrollment_id": {
                    "type": "string"
                },
                "gross_amount": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "merchant_order_id": {
                    "type": "string"
                },
                "net_amount": {
                    "type": "integer"
                },
                "paid_at": {
                    "type": "string"
                },
                "parent_id": {
                    "type": "string"
                },
                "payment_gateway_fee": {
                    "type": "integer"
                },
                "payment_gateway_provider": {
                    "type": "string"
                },
                "payment_intent_id": {
                    "type": "string"
                },
                "platform_fee": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "student_id": {
                    "type": "string"
                },
                "subtotal_amount": {
                    "type": "integer"
                },
                "tenant_id": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "voucher_id": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}